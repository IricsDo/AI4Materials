  <diagram id="Herc4Xa1jwgSzJ-qBgwg" name="Phase 1">
    <mxGraphModel dx="906" dy="458" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="Fqcc-HOJ9yWc45rgSe5b-1" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="260" width="817.14" x="691.4300000000001" y="30" as="geometry" />
        </mxCell>
        <mxCell id="Fqcc-HOJ9yWc45rgSe5b-2" parent="1" style="swimlane;whiteSpace=wrap;html=1;fontStyle=1;fontSize=16;fillColor=#76608a;strokeColor=#432D57;fontColor=#ffffff;" value="Phase 1" vertex="1">
          <mxGeometry height="1340" width="2120" x="40" y="320" as="geometry" />
        </mxCell>
        <mxCell id="DXkVov5Y3cZyI8BZf0V2-1" parent="Fqcc-HOJ9yWc45rgSe5b-2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=left;" value="&lt;div style=&quot;&quot;&gt;&lt;p data-start=&quot;185&quot; data-end=&quot;245&quot;&gt;&lt;strong data-start=&quot;185&quot; data-end=&quot;245&quot;&gt;&lt;font&gt;Bộ dữ liệu được sử dụng gồm 2 bộ: SuperCon và SuperBand.&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;p data-start=&quot;247&quot; data-end=&quot;655&quot;&gt;&lt;font&gt;&lt;strong data-start=&quot;247&quot; data-end=&quot;260&quot;&gt;SuperCon:&lt;/strong&gt; Là bộ dữ liệu về vật liệu siêu dẫn được thu thập và xây dựng bởi &lt;span class=&quot;hover:entity-accent entity-underline inline cursor-pointer align-baseline&quot;&gt;National Institute for Materials Science&lt;/span&gt; (NIMS), bao gồm hàng chục nghìn hợp chất siêu dẫn cùng với nhiệt độ tới hạn (critical temperature - Tc) và các thông tin thành phần hóa học tương ứng. Dữ liệu này chủ yếu được trích xuất từ các công bố khoa học và cơ sở dữ liệu vật liệu, nhằm hỗ trợ nghiên cứu dự đoán vật liệu siêu dẫn mới.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;657&quot; data-end=&quot;733&quot;&gt;&lt;font&gt;Các bài báo đã sử dụng bộ dữ liệu này chủ yếu tập trung vào các hướng sau:&lt;/font&gt;&lt;/p&gt;&lt;ul data-start=&quot;734&quot; data-end=&quot;1200&quot;&gt;&lt;li data-section-id=&quot;16525f1&quot; data-start=&quot;734&quot; data-end=&quot;865&quot;&gt;&lt;font&gt;&lt;strong data-start=&quot;736&quot; data-end=&quot;759&quot;&gt;Học máy dự đoán Tc:&lt;/strong&gt; sử dụng các mô hình như Random Forest, Gradient Boosting, Neural Networks để dự đoán nhiệt độ siêu dẫn.&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;li data-section-id=&quot;1r5tv7f&quot; data-start=&quot;866&quot; data-end=&quot;1008&quot;&gt;&lt;font&gt;&lt;strong data-start=&quot;868&quot; data-end=&quot;914&quot;&gt;Feature engineering từ thành phần hóa học:&lt;/strong&gt; xây dựng đặc trưng từ nguyên tố (atomic features, electronegativity, valence electrons...).&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;li data-section-id=&quot;xurw8z&quot; data-start=&quot;1009&quot; data-end=&quot;1109&quot;&gt;&lt;font&gt;&lt;span style=&quot;background-color: rgb(255, 0, 0);&quot;&gt;&lt;span data-start=&quot;1011&quot; data-end=&quot;1037&quot; style=&quot;&quot;&gt;&lt;b style=&quot;&quot;&gt;Khám phá vật liệu mới:&lt;/b&gt;&lt;/span&gt; sử dụng mô hình để đề xuất các hợp chất tiềm năng chưa được tổng hợp.&lt;/span&gt;&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;li data-section-id=&quot;zh740r&quot; data-start=&quot;1110&quot; data-end=&quot;1200&quot;&gt;&lt;font&gt;&lt;strong data-start=&quot;1112&quot; data-end=&quot;1146&quot;&gt;Explainable AI trong vật liệu:&lt;/strong&gt; phân tích yếu tố nào ảnh hưởng đến khả năng siêu dẫn.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p data-start=&quot;1202&quot; data-end=&quot;1250&quot;&gt;&lt;font&gt;Một số hướng bài báo tiêu biểu bạn có thể tìm:&lt;/font&gt;&lt;/p&gt;&lt;ul data-start=&quot;1251&quot; data-end=&quot;1459&quot;&gt;&lt;li data-section-id=&quot;b7o6o1&quot; data-start=&quot;1251&quot; data-end=&quot;1327&quot;&gt;&lt;font&gt;“Predicting superconducting critical temperature using machine learning”&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;li data-section-id=&quot;xnx25c&quot; data-start=&quot;1328&quot; data-end=&quot;1393&quot;&gt;&lt;font&gt;“Materials informatics approach to superconductors discovery”&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;li data-section-id=&quot;1b87k5&quot; data-start=&quot;1394&quot; data-end=&quot;1459&quot;&gt;&lt;font&gt;“Explainable machine learning for superconductivity prediction”&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/ul&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;hr data-start=&quot;1461&quot; data-end=&quot;1464&quot;&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;p data-start=&quot;1466&quot; data-end=&quot;1841&quot;&gt;&lt;font&gt;&lt;strong data-start=&quot;1466&quot; data-end=&quot;1480&quot;&gt;SuperBand:&lt;/strong&gt; Là bộ dữ liệu được phát triển và cung cấp bởi &lt;span class=&quot;hover:entity-accent entity-underline inline cursor-pointer align-baseline&quot;&gt;National Institute for Materials Science&lt;/span&gt;, tập trung vào các đặc trưng cấu trúc điện tử của vật liệu, đặc biệt là các thông tin liên quan đến &lt;strong data-start=&quot;1665&quot; data-end=&quot;1683&quot;&gt;band structure&lt;/strong&gt; (cấu trúc vùng năng lượng). Bộ dữ liệu này cung cấp các đặc trưng vật lý sâu hơn so với SuperCon, giúp phân tích cơ chế điện tử đứng sau hiện tượng siêu dẫn.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;1843&quot; data-end=&quot;1901&quot;&gt;&lt;font&gt;Các bài báo sử dụng SuperBand thường thuộc các nhóm sau:&lt;/font&gt;&lt;/p&gt;&lt;ul data-start=&quot;1902&quot; data-end=&quot;2294&quot;&gt;&lt;li data-section-id=&quot;tsqk5d&quot; data-start=&quot;1902&quot; data-end=&quot;2015&quot;&gt;&lt;font&gt;&lt;strong data-start=&quot;1904&quot; data-end=&quot;1946&quot;&gt;Phân tích band structure bằng học máy:&lt;/strong&gt; sử dụng deep learning để học biểu diễn từ dữ liệu vùng năng lượng.&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;li data-section-id=&quot;1nfz3k2&quot; data-start=&quot;2016&quot; data-end=&quot;2098&quot;&gt;&lt;font&gt;&lt;strong data-start=&quot;2018&quot; data-end=&quot;2050&quot;&gt;Kết hợp physics-informed ML:&lt;/strong&gt; đưa các định luật vật lý vào mô hình học máy.&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;li data-section-id=&quot;sscml9&quot; data-start=&quot;2099&quot; data-end=&quot;2186&quot;&gt;&lt;font&gt;&lt;strong data-start=&quot;2101&quot; data-end=&quot;2140&quot;&gt;Dự đoán tính chất điện tử nâng cao:&lt;/strong&gt; như density of states, band gap, Fermi .&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;li data-section-id=&quot;1pwlwu9&quot; data-start=&quot;2187&quot; data-end=&quot;2294&quot;&gt;&lt;font style=&quot;background-color: rgb(255, 0, 0);&quot;&gt;&lt;strong data-start=&quot;2189&quot; data-end=&quot;2242&quot; style=&quot;&quot;&gt;Liên hệ giữa band structure và superconductivity:&lt;/strong&gt; nghiên cứu mối quan hệ giữa cấu trúc điện tử và Tc.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p data-start=&quot;2296&quot; data-end=&quot;2329&quot;&gt;&lt;font&gt;Một số hướng bài báo tiêu biểu:&lt;/font&gt;&lt;/p&gt;&lt;ul data-start=&quot;2330&quot; data-end=&quot;2505&quot;&gt;&lt;li data-section-id=&quot;g53azd&quot; data-start=&quot;2330&quot; data-end=&quot;2390&quot;&gt;&lt;font&gt;“Deep learning for electronic band structure prediction”&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;li data-section-id=&quot;xozp7d&quot; data-start=&quot;2391&quot; data-end=&quot;2452&quot;&gt;&lt;font&gt;“Physics-informed machine learning for materials science”&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;li data-section-id=&quot;1ghy1g0&quot; data-start=&quot;2453&quot; data-end=&quot;2505&quot;&gt;&lt;font&gt;“Band structure descriptors for superconductivity”&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;h2 data-section-id=&quot;17km6dn&quot; data-start=&quot;0&quot; data-end=&quot;15&quot;&gt;&lt;br&gt;&lt;/h2&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="970" width="2040" x="40" y="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
