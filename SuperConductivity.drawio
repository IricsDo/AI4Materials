        <mxCell id="h4yDm1v14O9jg-1mk3G2-9" parent="h4yDm1v14O9jg-1mk3G2-5" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&#xa;&lt;b data-path-to-node=&quot;4,2,0&quot; data-index-in-node=&quot;0&quot;&gt;Trích xuất bề mặt Fermi:&lt;/b&gt; Phân tích các đặc tính hình học và topo của bề mặt Fermi (vùng quyết định tính dẫn điện).&#xa;&#xa;" vertex="1">
