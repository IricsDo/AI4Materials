        </mxCell>
        <mxCell id="h4yDm1v14O9jg-1mk3G2-15" parent="h4yDm1v14O9jg-1mk3G2-5" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;br&gt;&lt;b data-path-to-node=&quot;4,3,0&quot; data-index-in-node=&quot;0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;Phân tích Orbital:&lt;/b&gt; Chia nhỏ đóng góp của các lớp electron (&lt;span class=&quot;math-inline&quot; data-math=&quot;s, p, d, f&quot; data-index-in-node=&quot;59&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;s, p, d, f&lt;/span&gt;) vào khả năng siêu dẫn.&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="980" y="360" as="geometry" />
        </mxCell>
        <mxCell id="h4yDm1v14O9jg-1mk3G2-14" parent="h4yDm1v14O9jg-1mk3G2-5" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;br&gt;&lt;b data-path-to-node=&quot;6,0,0&quot; data-index-in-node=&quot;0&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;Độ chính xác dự đoán:&lt;/b&gt; Mô hình đạt hệ số tương quan &lt;b data-path-to-node=&quot;6,0,0&quot; data-index-in-node=&quot;51&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;&lt;span class=&quot;math-inline&quot; data-math=&quot;R = 0,887&quot; data-index-in-node=&quot;51&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;R = 0,887&lt;/span&gt;&lt;/b&gt;&amp;nbsp;khi dự đoán nhiệt độ siêu dẫn &lt;span class=&quot;math-inline&quot; data-math=&quot;T_c&quot; data-index-in-node=&quot;91&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important;&quot;&gt;Tc&lt;/span&gt;.&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="980" y="410" as="geometry" />
        </mxCell>
        <mxCell id="h4yDm1v14O9jg-1mk3G2-13" parent="h4yDm1v14O9jg-1mk3G2-5" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;b data-path-to-node=&quot;6,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Sàng lọc diện rộng:&lt;/b&gt; Thử nghiệm mô hình trên &lt;b data-path-to-node=&quot;6,1,0&quot; data-index-in-node=&quot;44&quot;&gt;46.564&lt;/b&gt; vật liệu từ thư viện ICSD." vertex="1">
