        <mxCell id="h4yDm1v14O9jg-1mk3G2-10" parent="h4yDm1v14O9jg-1mk3G2-5" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&#xa;&lt;b data-path-to-node=&quot;4,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Tensor hóa 4 chiều:&lt;/b&gt; Chuyển đổi dữ liệu vật lý thành các &lt;b data-path-to-node=&quot;4,1,0&quot; data-index-in-node=&quot;56&quot;&gt;4D tensors&lt;/b&gt; để &quot;dạy&quot; cho các mô hình Deep Learning.&#xa;&#xa;" vertex="1">
